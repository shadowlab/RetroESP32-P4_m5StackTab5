# M5Stack Tab5 variant - layer on top of sdkconfig.defaults (launcher) or
# apps/sdkconfig_common.defaults (emulator apps), e.g.
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;../../launcher/sdkconfig.tab5.defaults" build
# build_all_tab5.sh does this for every project.

CONFIG_BOARD_M5STACK_TAB5=y

# The Tab5's ESP32-P4 is a pre-v3 chip (v1.x). These are ESP-IDF 5.5's defaults; they are spelled out
# because ESP-IDF 6 defaults to v3.1+ and an image built for one revision family does not boot on the other.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# Flash + execution, as in M5Stack's own Tab5 firmware:
#  - the Tab5's flash is wired for quad I/O
#  - copy code (.text) and constants (.rodata) into the 200 MHz HEX PSRAM at boot and run from
#    there, so instruction/rodata cache misses no longer go to 80 MHz flash. Costs ~app-size of
#    PSRAM (<= 1.5 MB of 32 MB) and a short copy at boot.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Display: double buffering is on by default (CONFIG_TAB5_DOUBLE_BUFFER).  The panel pixel clocks
# default to the esp-bsp values (~48 Hz on v1, ~58 Hz on v2/v3).  For ~60 Hz (outside the tested
# timings - try on the device) uncomment:
# CONFIG_TAB5_ILI9881C_DPI_CLOCK_MHZ=75
# CONFIG_TAB5_ST712X_DPI_CLOCK_MHZ=73

# The emulator cores are third-party code that is not warning-clean on newer GCC (ESP-IDF 6 ships
# GCC 15 and turns more warnings into errors). Keep warnings as warnings.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# Keyboard port (Ext.Port1): the stock M5Stack Tab5 Keyboard works as a gamepad, and the RetroPad
# console boards (hardware/tab5_controller) plug in here too.
CONFIG_TAB5_CTRL_ENABLE=y
CONFIG_TAB5_CTRL_I2C_SDA=0
CONFIG_TAB5_CTRL_I2C_SCL=1

# USB drive mode (launcher > Settings > USB DRIVE): the SD card as a USB mass storage device on the
# USB-C port. Only the launcher depends on esp_tinyusb; the emulator apps ignore these.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="RetroESP32"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Tab5 SD card"
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
CONFIG_TINYUSB_DESC_MSC_STRING="Tab5 SD card"

# Wi-Fi transfer (launcher > Settings > WI-FI TRANSFER): Wi-Fi through the ESP32-C6 (ESP-Hosted over SDIO,
# SDMMC slot 1 next to the SD card on slot 0). The launcher powers the C6 and starts ESP-Hosted itself, only
# when Wi-Fi transfer is opened. Only the launcher depends on esp_hosted; the emulator apps ignore these.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
# CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN is not set
# Same clock as the SD card (SDMMC_FREQ_HIGHSPEED): the two slots share the host clock divider
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_WIFI_RMT_NVS_ENABLED=n
# Browsers send more header bytes than the 512 default, and the API puts paths in the URL
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048
# Bigger TCP windows for file transfer throughput (the buffers come from PSRAM)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
